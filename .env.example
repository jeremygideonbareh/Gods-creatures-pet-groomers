# Nhost
VITE_NHOST_SUBDOMAIN=your-subdomain
VITE_NHOST_REGION=your-region

# Admin
# Comma-separated list of admin emails
VITE_ADMIN_EMAIL=admin@example.com,another@example.com

# Razorpay
VITE_RAZORPAY_KEY_ID=rzp_test_xxx

# Cashfree
# sandbox (default) or production — must match the backend CASHFREE_API_URL environment
VITE_CASHFREE_MODE=sandbox

# (backend vars documented separately in docs/env-vars.md)
# The following variables are required in the Nhost Dashboard for backend functions:
# RAZORPAY_KEY_ID
# RAZORPAY_KEY_SECRET
# RAZORPAY_WEBHOOK_SECRET
# RESEND_API_KEY
# RESEND_FROM_EMAIL
# HASURA_GRAPHQL_ADMIN_SECRET
